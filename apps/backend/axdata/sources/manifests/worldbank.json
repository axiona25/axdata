{
  "source_id": "worldbank",
  "name": "World Bank Open Data API",
  "kind": "api",
  "sectors": ["economy", "health", "society", "environment"],
  "subsectors": ["development", "statistics"],
  "data_types": ["tabular", "time_series", "cross_sectional", "panel"],
  "geo_coverage": {
    "scope": "global",
    "levels": ["country", "region"],
    "crs": "EPSG:4326"
  },
  "time_coverage": {
    "start": "1960",
    "end": "present"
  },
  "variables_offered": [],
  "endpoints": [
    {
      "id": "indicators",
      "path": "/api/v2/country/{country}/indicator/{indicator}",
      "method": "GET",
      "supports": {
        "time": true,
        "geo": true,
        "pagination": true
      }
    }
  ],
  "license": {
    "name": "CC BY 4.0",
