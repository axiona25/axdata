{
  "source_id": "who_gho",
  "name": "WHO Global Health Observatory",
  "kind": "api",
  "sectors": ["health"],
  "subsectors": ["epidemiology", "public_health"],
  "data_types": ["tabular", "time_series", "cross_sectional"],
  "geo_coverage": {
    "scope": "global",
    "levels": ["country", "region"],
