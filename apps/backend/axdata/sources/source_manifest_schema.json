{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axdata.eu/schemas/source-manifest-v1.json",
  "title": "AXDATA Source Manifest v1",
  "type": "object",
  "required": ["source_id", "name", "kind", "sectors", "data_types", "geo_coverage", "time_coverage", "endpoints", "license", "authority"],
  "properties": {
    "source_id": { "type": "string", "pattern": "^[a-z0-9_\\-]{3,64}$" },
    "name": { "type": "string" },
    "kind": { "type": "string", "enum": ["api", "dataset", "scrape"] },
    "sectors": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "subsectors": { "type": "array", "items": { "type": "string" } },
    "data_types": {
      "type": "array",
      "items": { "type": "string", "enum": ["tabular", "time_series", "cross_sectional", "panel", "geospatial", "text", "event", "hybrid"] },
      "minItems": 1
    },
    "geo_coverage": {
      "type": "object",
      "required": ["scope", "levels"],
      "properties": {
        "scope": { "type": "string", "description": "global, EU, IT, etc." },
        "levels": { "type": "array", "items": { "type": "string" } },
        "crs": { "type": "string", "default": "EPSG:4326" }
      }
    },
    "time_coverage": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "description": "YYYY or YYYY-MM-DD" },
        "end": { "type": "string", "description": "YYYY or YYYY-MM-DD or present" }
      }
    },
    "variables_offered": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["numeric", "categorical", "text", "event", "geo"] },
          "unit": { "type": "string" }
        }
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "method", "supports"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "method": { "type": "string", "enum": ["GET", "POST"] },
          "supports": {
            "type": "object",
            "properties": {
              "time": { "type": "boolean", "default": false },
              "geo": { "type": "boolean", "default": false },
              "pagination": { "type": "boolean", "default": true }
            }
          }
        }
      }
    },
    "license": {
      "type": "object",
      "required": ["name", "url", "commercial_use"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "commercial_use": { "type": "boolean" },
        "attribution_required": { "type": "boolean", "default": true }
      }
    },
    "authority": {
      "type": "object",
      "required": ["level"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 5 },
        "publisher": { "type": "string" }
      }
    },
    "reliability": {
      "type": "object",
      "properties": {
        "uptime_score": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.95 },
        "rate_limit_per_min": { "type": "integer", "default": 60 }
      }
    }
  }
}
